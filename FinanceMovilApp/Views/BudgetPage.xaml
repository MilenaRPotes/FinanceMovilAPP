<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinanceMovilApp.ViewModels"
             xmlns:models="clr-namespace:FinanceMovilApp.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="FinanceMovilApp.Views.BudgetPage"
             BackgroundColor="{StaticResource DarkPrimaryBackground}"
             Title="Presupuesto"
            >

    <!-- Cargar datos al entrar -->
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding LoadDataCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="20">
        <!-- Padding inferior para el FAB -->

        <!-- CABECERA: Resumen de Asignación -->
        <Frame Grid.Row="0" 
               BackgroundColor="{StaticResource DarkSecondaryBackground}" 
               BorderColor="{StaticResource DarkAccent}"
               CornerRadius="20"
               HasShadow="True"
               >
            <VerticalStackLayout Spacing="10" >
                <Label Text="TU REINO FINANCIERO" 
                       TextColor="{StaticResource DarkAccent}"
                       FontFamily="LoraFont"
                       FontSize="18"
                       HorizontalOptions="Center"/> 
                
                <!-- Ingreso Total -->
                <VerticalStackLayout Spacing="0" Margin="0,5">

                    <Label Text="{Binding CurrentMonth, StringFormat='INGRESO DISPONIBLE {0}'}" 
                           TextColor="{StaticResource LightSecondaryText}" 
                           FontSize="12" 
                           HorizontalOptions="Center" 
                           FontAttributes="Bold"
                           TextTransform="Uppercase"/>

                    <Label Text="{Binding TotalIncome, StringFormat='{0:C0}'}" 
                           TextColor="{StaticResource LightPrimaryBackground}" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>

                <!-- Barra de Asignación General -->
                <VerticalStackLayout Spacing="5">
                    <Grid ColumnDefinitions= "Auto, *" ColumnSpacing="15">
                        <Label Grid.Column="0" 
                               Text="{Binding AssignedPercentage, StringFormat='Asignado: {0:P0}'}" 
                               TextColor="{StaticResource DarkAccent}" 
                               FontSize="12"
                               VerticalOptions="Center"/>

                        <Label Grid.Column="1" 
                               Text="{Binding RemainingToAssign, StringFormat='Por Asignar: {0:C0}'}" 
                               TextColor="{StaticResource VerdeCrecimiento}" 
                               FontSize="12" 
                               HorizontalOptions="End"
                               VerticalOptions="Center"/>
                    </Grid>
                    <ProgressBar Progress="{Binding AssignedPercentage}" 
                                 ProgressColor="{StaticResource DarkAccent}" 
                                 ScaleY="2"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <!-- LISTA DE PRESUPUESTOS POR CATEGORÍA -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Budgets}"
                        SelectionMode="None"
                        Margin="0,10,0,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BudgetModel">

                    <!-- SwipeView para Editar/Borrar -->
                    <SwipeView Threshold="100">

                        <!-- Deslizar Izquierda: BORRAR -->
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Eliminar"
                                           BackgroundColor="{StaticResource RojoCoral}"
                                           IconImageSource="delete.png"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:BudgetViewModel}}, Path=DeleteBudgetCommand}"
                                           CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <!-- Deslizar Derecha: EDITAR -->
                        <SwipeView.LeftItems>
                            <SwipeItems>
                                <SwipeItem Text="Editar"
                                           BackgroundColor="{StaticResource LightSecondaryText}"
                                           IconImageSource="edit.png"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:BudgetViewModel}}, Path=EditBudgetCommand}"
                                           CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.LeftItems>

                        <!-- Tarjeta de Presupuesto -->
                        <Grid Padding="2,0">
                            <Frame BackgroundColor="{StaticResource DarkSecondaryBackground}" 
                                   BorderColor="Transparent"
                                   CornerRadius="15"
                                   HasShadow="True"
                                   Padding="15">
                                <VerticalStackLayout Spacing="8">

                                    <!-- Nombre Categoría y Estado -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label 
                                               Grid.Column="0"
                                               Text="{Binding CategoryName}" 
                                               TextColor="{StaticResource LightPrimaryBackground}" 
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               FontFamily="InterFont"/>

                                        <!-- Muestra el % ejecutado -->
                                        <Label 
                                               Grid.Column="1"
                                               Text="{Binding Progress, StringFormat='{0:P0}'}" 
                                               TextColor="{Binding StatusColor}" 
                                               FontAttributes="Bold"/>
                                    </Grid>

                                    <!-- Barra de Progreso (Color dinámico según StatusColor) -->
                                    <ProgressBar Progress="{Binding Progress}" 
                                                 ProgressColor="{Binding StatusColor}" 
                                                 ScaleY="2"/>

                                    <!-- Cifras: Gastado vs Planeado -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="Gastado:" TextColor="{StaticResource LightSecondaryText}" FontSize="12"/>
                                            <Label Text="{Binding ActualSpent, StringFormat='{0:C0}'}" 
                                                   TextColor="{StaticResource LightPrimaryBackground}" 
                                                   FontSize="12"
                                                   FontAttributes="Bold"/>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="5" Grid.Column="1">
                                            <Label Text="Meta:" TextColor="{StaticResource LightSecondaryText}" FontSize="12"/>
                                            <Label Text="{Binding PlannedAmount, StringFormat='{0:C0}'}" 
                                                   TextColor="{StaticResource DarkAccent}" 
                                                   FontSize="12"
                                                   FontAttributes="Bold"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                    
                                    <!--Mensaje de Alerta por sobre-giro de presupuesto-->

                                    <Label Text="⚠️ Cuidado: Gasto excede plan. Ajusta tu presupuesto."
                                           TextColor="{StaticResource RojoCoral}"
                                           FontSize="11"
                                           IsVisible="{Binding IsOverspent}"
                                           FontAttributes="Italic"
                                           LineBreakMode="WordWrap"/>

                                </VerticalStackLayout>
                            </Frame>
                        </Grid>
                    </SwipeView>

                </DataTemplate>
            </CollectionView.ItemTemplate>
            
            <!--  Footer (Espacio vacío) para que la última card suba -->
            <CollectionView.Footer>
                <BoxView HeightRequest="100" Color="Transparent" />
            </CollectionView.Footer>

            <!-- Vista Vacía -->
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                    <Label Text="🧭" FontSize="50" HorizontalOptions="Center"/>
                    <Label Text="No hay presupuesto aún" 
                           TextColor="{StaticResource LightSecondaryText}" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Asigna un presupuesto a cada categoría de tu imperio." 
                           TextColor="{StaticResource DarkAccent}" 
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Botón Flotante (FAB) -->
        <Button Grid.Row="1"
                Text="+"
                Command="{Binding AddBudgetCommand}"
                BackgroundColor="{StaticResource DarkAccent}"
                TextColor="{StaticResource LightPrimaryText}"
                FontSize="30"
                CornerRadius="30"
                WidthRequest="60"
                HeightRequest="60"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Shadow="{Shadow Brush=Black, Offset='5,5', Opacity=0.5}"/>

    </Grid>
</ContentPage>